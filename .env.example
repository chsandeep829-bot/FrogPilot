# Copy this file to .env and add your own API settings.
# Example for an OpenAI-compatible gateway such as OmniRoute:
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=replace-with-your-own-key
AI_MODEL=your-supported-model-id
PORT=3000

# Optional: set true to allow generated files to be downloaded as a ZIP.
ENABLE_PROJECT_EXPORT=true

# Cloudflare Pages Direct Upload (backend creates a separate Pages project for each app).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-pages-write-api-token
CLOUDFLARE_PAGES_PROJECT_NAME=forgepilot
# A separate secret that protects the app's deploy endpoint; choose your own strong value.
DEPLOYMENT_ACCESS_KEY=replace-with-a-long-random-secret
